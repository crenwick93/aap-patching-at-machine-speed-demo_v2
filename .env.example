# AAP Gateway
AAP_HOSTNAME=https://aaponprem.chrislab.dev
AAP_INTERNAL_HOST=https://192.168.50.251
AAP_TOKEN=
AAP_VALIDATE_CERTS=false

# SSH key for demo EC2 instances
PROBE_SSH_KEY_PATH=./patching-demo.pem

# AWS (for dynamic inventory + reset provisioning)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
DEMO_AMI_ID=
DEMO_INSTANCE_TYPE=t3.small
DEMO_SUBNET_ID=
DEMO_SECURITY_GROUP_ID=
DEMO_KEY_NAME=patching-demo

# Red Hat subscription (register fresh demo nodes with Insights)
# Create an activation key at: https://console.redhat.com/insights/connector/activation-keys
RH_ORG_ID=
RH_ACTIVATION_KEY=

# Red Hat Lightspeed API (Insights CVE status updates in PIR + reset cleanup)
# Service account client credentials from console.redhat.com → IAM → Service Accounts
LIGHTSPEED_CLIENT_ID=
LIGHTSPEED_CLIENT_SECRET=

# ServiceNow PDI
SERVICENOW_INSTANCE_URL=https://ven08501.service-now.com/
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=

# EDA Event Stream (for simulated Lightspeed CVE events)
# After CaC apply, copy the "Lightspeed CVE Events Full Patch token" stream URL + token
EDA_EVENT_STREAM_URL=https://aaponprem.chrislab.dev/eda-event-streams/api/eda/v1/external_event_stream/<uuid>/post/
EDA_EVENT_STREAM_TOKEN=

# Git repo URL (defaults to this repo on GitHub)
GIT_REPO_URL=https://github.com/crenwick93/aap-patching-at-machine-speed-demo_v2.git
